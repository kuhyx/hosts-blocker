{
	"manifest_version": 3,
	"name": "f",
	"version": "1.0",
	"permissions": ["webNavigation", "tabs"],
	"host_permissions": ["*://*.facebook.com/*"],
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"browser_specific_settings": {
		"gecko": { "id": "fb-spa-guard@hosts-blocker" }
	}
}
